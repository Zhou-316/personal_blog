# Local fallback values. Set production values in Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BLOG_DATABASE_PATH=./blog.db
BLOG_SECRET_KEY=change-this-secret-before-deploy

# Optional: AI summary service. Render should use environment variables, not api.md.
BLOG_AI_API_KEY=
BLOG_AI_BASE_URL=
BLOG_AI_MODEL=

# Private, self-hosted NetEase adapter (Node.js service in music-service/).
BLOG_MUSIC_API_URL=http://127.0.0.1:3001
# Set true on the production HTTPS site. Keep false for local HTTP acceptance.
BLOG_MUSIC_COOKIE_SECURE=false
